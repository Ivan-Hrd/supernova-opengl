#version 450
uniform sampler2D texture_sampler;
uniform sampler2D noise_sampler;
uniform float uTime;
uniform int uClicked;
uniform float uClickTime;

layout(location=0) out vec4 output_color;

const vec2 windowSize = vec2(1920., 1080.);
const float aspect = windowSize.x/windowSize.y;
const float maxRadius = 1;

#define pi 3.14159265
#define R(p, a) p=cos(a)*p+sin(a)*vec2(p.y, -p.x)

const float nudge = 0.739513;
float normalizer = 1.0 / sqrt(1.0 + nudge*nudge);

float SpiralNoiseC(vec3 p)
{
    float n = 0.0;
    float iter = 1.0;
    for (int i = 0; i < 8; i++)
    {
        n += -abs(sin(p.y*iter) + cos(p.x*iter))/iter;
        // rotation
        p.xy += vec2(p.y, -p.x)*nudge;
        p.xy *= normalizer;
        p.xz += vec2(p.z, -p.x)*nudge;
        p.xz *= normalizer;
        // augmente la fréquence
        iter *= 1.733733;
    }
    return n;
}

float SpiralNoise3D(vec3 p)
{
    float n = 0.0;
    float iter = 1.0;
    for (int i = 0; i < 5; i++)
    {
        n += (sin(p.y*iter) + cos(p.x*iter))/iter;
        // rotation
        p.xz += vec2(p.z, -p.x)*nudge;
        p.xz *= normalizer;
        // augmente la fréquence
        iter *= 1.33733;
    }
    return n;
}

float NebulaNoise(vec3 p)
{
    float final = p.y +4.5;
    final -= SpiralNoiseC(p.xyz);   // deformation vers le haut (+y car -(-))
    final += SpiralNoiseC(p.zxy*0.5123+100.0)*4.0;   // deformation vers le bas (-y)
    final -= SpiralNoise3D(p); // deformation en haut et en bas, ajoute de l'aleatoire

    return final;
}

float map(vec3 p)
{
    R(p.xz, uTime*0.03);

    // on joue avec les scalaires pour modifier la densité
    float NebNoise = abs(NebulaNoise(p/0.5)*0.5);
    return NebNoise + 0.03;
}

vec3 computeColor( float density, float radius )
{
    vec3 result = mix( vec3(0.6, 0.3, 0.9), vec3(0.02, 0.0, 0.08), density );

    vec3 colCenter = 8.*vec3(0.7, 0.4, 1.0);
    vec3 colEdge = 1.2*vec3(0.5, 0.1, 1.0);
    result *= mix( colCenter, colEdge, min( (radius+.05)/.9, 1.15 ) );

    return result;
}

bool RaySphereIntersect(vec3 org, vec3 dir, out float near, out float far)
{
	float b = dot(dir, org);
	float c = dot(org, org) - 8.;
	float delta = b*b - c;
	if( delta < 0.0)
		return false;
	float deltasqrt = sqrt(delta);
	near = -b - deltasqrt;
	far = -b + deltasqrt;
	return far > 0.0;
}

uint lowbias32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

float hash(vec2 p) {

    uint pnew = floatBitsToUint(p.x) ^ (floatBitsToUint(p.y));
    pnew = lowbias32(pnew);
    return float(pnew) / float(0xffffffffU);
}

vec3 stars(vec2 uv, float cellSize, float time) {

    vec2 cell  = floor(uv / cellSize);
    vec2 local = uv / cellSize - floor(uv / cellSize); // get frag position in the cell

    // one cell = 1 star of each kind
    vec2 starPos = vec2(hash(cell+1.3), hash(cell + 17.37));

    vec2 d = (local - starPos) * vec2(aspect, 1.0);
    float dist = length(d);

    float bri     = hash(cell + 3.7);
    float speed   = hash(cell + 9.1) * 2.5 + 0.5;
    float phase   = hash(cell + 53.0) * 6.28;
    float twinkle = 0.7 + 0.3 * sin(time * speed + phase);

    float radius = 0.008 + bri * 0.008;

    float core = smoothstep(radius, radius * 0.2, dist);
    float halo = smoothstep(radius * 3.0, 0.0, dist) * 0.3;

    float intensity = pow(bri, 1.5);
    float glow = (core + halo) * intensity * twinkle * 3.0;

    vec3 color = vec3(1., 1., 1.);

    return color * glow;
}

vec3 nova(vec2 uv, float time) {

    vec2 local = uv;
    vec2 novaPos = vec2(0.5, 0.5);
    vec2 d = (local - novaPos) * vec2(aspect, 1.0);
    float dist = length(d);

    float coef = 1.0f;
    if (uClicked != 0.0f) {
        coef -= (uTime - uClickTime);
        coef = clamp(coef, 0., 1.);
    }
    float novaRadius = 0.1*coef;
    // float intensity = smoothstep(novaRadius,0.0,dist);
    float edgeWidth  = 0.03;
    float intensity = clamp((novaRadius - dist) / edgeWidth, 0.0, 1.0);
    float speed = float(lowbias32(floatBitsToUint(9.1)))  / float(0xffffffffU) * 2.5 + 0.5;
    float phase = float(lowbias32(floatBitsToUint(53.1))) / float(0xffffffffU) * 6.28;
    float twinkle = 0.7 + 0.3 * sin(time * speed + phase);

    float halo = smoothstep(novaRadius * 3.0, 0.0, dist)*0.9;


    vec3 color = vec3(.8,.8,1.);

    return ( color * (intensity+halo*twinkle));
}

float getOffsetStrength(float t, vec2 dir) {
  float d = length(dir*vec2(aspect, 1.0)) - t * maxRadius; // SDF of circle

  d *= 1. - smoothstep(0., 0.05, abs(d)); // Mask the ripple

  d *= smoothstep(0., 0.05, t); // Smooth intro
  d *= 1. - smoothstep(0.5, 1., t); // Smooth outro
  return d*2;
}


void main() {
    vec2 uv = gl_FragCoord.xy / windowSize;
    vec2 dir = uv - vec2(0.5,0.5);

    float tOffset = 0.05 * sin(uTime - uClickTime * 3.14);
    float rD = getOffsetStrength(uTime - uClickTime + tOffset, dir);
    float gD = getOffsetStrength(uTime - uClickTime, dir);
    float bD = getOffsetStrength(uTime - uClickTime - tOffset, dir);

    dir = normalize(dir);

    vec4 texel;
    texel.r = texture(texture_sampler, uv + dir * rD * uClicked).r;
    texel.g = texture(texture_sampler, uv + dir * gD * uClicked).g;
    texel.b = texture(texture_sampler, uv + dir * bD * uClicked).b;

    vec3 starGlow = vec3(0.0);
    starGlow += stars(uv, 0.08, uTime);
    starGlow += stars(uv, 0.12, uTime);
    starGlow += stars(uv, 0.25, uTime);

    vec3 novaGlow = vec3(0.0);
    novaGlow += nova(uv, uTime);

    /*
        NEBULA BEGIN
    */
    vec3 rd = normalize(vec3((gl_FragCoord.xy-0.5*windowSize.xy)/windowSize.y, 1.));
    vec3 ro = vec3(0., 0., -6.);

    float ld=0., td=0., w=0.;
    float d=1., t=0.;

    float h = 0.1;

    vec4 nebulaSum = vec4(0.0);
    float min_dist=0.0, max_dist=0.0;
    if (RaySphereIntersect(ro, rd, min_dist, max_dist))
    {
        t = min_dist*step(t,min_dist);
        for (int i=0; i<56; i++)
        {
            vec3 pos = ro + t*rd;
            if(td>0.9 || d<0.1*t || t>10. || nebulaSum.a > 0.99 || t>max_dist) break;
            float d = map(pos);
            d = max(d, 0.08);

            vec3 ldst = vec3(0.0)-pos;
            float lDist = max(length(ldst), 0.001);
            vec3 lightColor = vec3(0.5, 0.1, 1.0);
            nebulaSum.rgb += (lightColor/(lDist*lDist)/22.);            if (d<h)

            if (d<h){
                ld = h-d;
                w = (1. - td) * ld;
                td += w + 1./200.;
                vec4 col = vec4(computeColor(td, lDist), td);
                col.a *= 0.185;
                col.rgb *= col.a;
                nebulaSum = nebulaSum + col*(1. - nebulaSum.a);
            }
            td += 1./70.;

            t += max(d*0.1*max(min(length(ldst), length(ro)), 1.0), 0.02);
        }
    }

    /*
        NEBULA END
    */

    output_color = vec4(texel.rgb + starGlow + novaGlow, 1.0);
    output_color += nebulaSum;
}