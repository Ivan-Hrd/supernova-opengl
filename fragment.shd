#version 410
uniform sampler2D texture_sampler;
uniform float uTime;
uniform int uClicked;
uniform float uClickTime;

layout(location=0) out vec4 output_color;

uniform vec2 windowSize;            // actual render resolution (set from C++)
const float aspect = 1920.0/1080.0; // fixed 16:9, independent of render scale
const float maxRadius = 1;

uint lowbias32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

float hash(vec2 p) {

    uint pnew = floatBitsToUint(p.x) ^ (floatBitsToUint(p.y));
    pnew = lowbias32(pnew);
    return float(pnew) / float(0xffffffffU);
}

vec3 stars(vec2 uv, float cellSize, float time) {

    vec2 cell  = floor(uv / cellSize);
    vec2 local = uv / cellSize - floor(uv / cellSize); // get frag position in the cell

    // one cell = 1 star of each kind
    vec2 starPos = vec2(hash(cell+1.3), hash(cell + 17.37));

    vec2 d = (local - starPos) * vec2(aspect, 1.0);
    float dist = length(d);

    float bri     = hash(cell + 3.7);
    float speed   = hash(cell + 9.1) * 2.5 + 0.5;
    float phase   = hash(cell + 53.0) * 6.28;
    float twinkle = 0.7 + 0.3 * sin(time * speed + phase);

    float radius = 0.008 + bri * 0.008;

    float core = smoothstep(radius, radius * 0.2, dist);
    float halo = smoothstep(radius * 3.0, 0.0, dist) * 0.3;

    float intensity = pow(bri, 1.5);
    float glow = (core + halo) * intensity * twinkle * 3.0;

    vec3 color = vec3(1., 1., 1.);

    return color * glow;
}

vec3 nova(vec2 uv, float time) {

    vec2 local = uv;
    vec2 novaPos = vec2(0.5, 0.5);
    vec2 d = (local - novaPos) * vec2(aspect, 1.0);
    float dist = length(d);

    float coef = 1.0f;
    if (uClicked != 0.0f) {
        coef -= (uTime - uClickTime);
        coef = clamp(coef, 0., 1.);
    }
    float novaRadius = 0.1*coef;
    // float intensity = smoothstep(novaRadius,0.0,dist);
    float edgeWidth  = 0.03;
    float intensity = clamp((novaRadius - dist) / edgeWidth, 0.0, 1.0);
    float speed = float(lowbias32(floatBitsToUint(9.1)))  / float(0xffffffffU) * 2.5 + 0.5;
    float phase = float(lowbias32(floatBitsToUint(53.1))) / float(0xffffffffU) * 6.28;
    float twinkle = 0.7 + 0.3 * sin(time * speed + phase);

    float halo = smoothstep(novaRadius * 3.0, 0.0, dist)*0.9;


    vec3 color = vec3(.8,.8,1.);

    return ( color * (intensity+halo*twinkle));
}

float getOffsetStrength(float t, vec2 dir) {
  float d = length(dir*vec2(aspect, 1.0)) - t * maxRadius; // SDF of circle

  d *= 1. - smoothstep(0., 0.05, abs(d)); // Mask the ripple

  d *= smoothstep(0., 0.05, t); // Smooth intro
  d *= 1. - smoothstep(0.5, 1., t); // Smooth outro
  return d*2;
}

//=====================================================================
// Volumetric supernova
// Ported from "Type 2 Supernova" by Duke (https://www.shadertoy.com/view/lsyXDK)
// CC BY-NC-SA 3.0. Texture-based noise replaced by procedural 3D value noise.
//=====================================================================

#define pi 3.14159265
#define R(p, a) p=cos(a)*p+sin(a)*vec2(p.y, -p.x)

// procedural hash for 3D value noise (replaces the iChannel0 texture lookup)
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

// iq's value noise, procedural version (same output range as the original)
float noise( in vec3 x )
{
    vec3 p = floor(x);
    vec3 f = fract(x);
    f = f*f*(3.0-2.0*f);
    float n = mix(
        mix(mix(hash13(p+vec3(0,0,0)), hash13(p+vec3(1,0,0)), f.x),
            mix(hash13(p+vec3(0,1,0)), hash13(p+vec3(1,1,0)), f.x), f.y),
        mix(mix(hash13(p+vec3(0,0,1)), hash13(p+vec3(1,0,1)), f.x),
            mix(hash13(p+vec3(0,1,1)), hash13(p+vec3(1,1,1)), f.x), f.y), f.z);
    return 1. - 0.82*n;
}

float fbm( vec3 p )
{
   return noise(p*.06125)*.5 + noise(p*.125)*.25 + noise(p*.25)*.125 + noise(p*.4)*.2;
}

float Sphere( vec3 p, float r )
{
    return length(p)-r;
}

// otaviogood's spiral noise (https://www.shadertoy.com/view/ld2SzK)
const float nudge = 4.;                  // size of perpendicular vector
const float normalizer = 0.242535625;    // 1.0 / sqrt(1.0 + nudge*nudge)
float SpiralNoiseC(vec3 p)
{
    float n = 1. + clamp((uTime - uClickTime) * 0.1, 0., 1.); // noise amount (one-shot, no loop)
    float iter = 2.0;
    for (int i = 0; i < 8; i++)
    {
        n += -abs(sin(p.y*iter) + cos(p.x*iter)) / iter;
        p.xy += vec2(p.y, -p.x) * nudge;
        p.xy *= normalizer;
        p.xz += vec2(p.z, -p.x) * nudge;
        p.xz *= normalizer;
        iter *= 1.733733;
    }
    return n;
}

float VolumetricExplosion(vec3 p)
{
    float final = Sphere(p,4.);
    final += noise(p*20.)*.4;
    final += SpiralNoiseC(p.zxy*fbm(p*10.))*2.5;
    return final;
}

// supernova timeline (seconds, measured from the click)
const float tExpand = 2.5;  // expansion: the blast grows to full size
const float tFly    = 3.0;  // fly-through: camera dives into the blast until it leaves the frame
const float flyDist = 10.0; // camera forward travel during the fly-through

// nebula remnant timeline (seconds, measured from the click) -- ADJUST THESE
const float nebulaStart = 1.5; // when the nebula starts to appear
const float nebulaFade  = 2.5; // how long it takes to fully fade in

float map(vec3 p)
{
    R(p.xz, uTime*0.1); // auto-rotation (replaces iMouse)

    // Expand from the click instant up to full size, then stay there (no implosion).
    float localT = max(uTime - uClickTime, 0.0);
    float grow;
    if (localT < tExpand) {
        float x = localT / tExpand;
        grow = 1.0 - pow(1.0 - x, 2.0);        // ease-out: fast then decelerate
    } else {
        grow = 1.0;                            // hold full size
    }
    grow = grow * 0.95 + 0.05;
    float VolExplosion = VolumetricExplosion(p/grow)*grow;

    return abs(VolExplosion)+0.07;
}

// assign color to the media
vec3 computeColor( float density, float radius )
{
    vec3 result = mix( vec3(1.0,0.9,0.8), vec3(0.4,0.15,0.1), density );

    vec3 colCenter = 7.*vec3(0.8,1.0,1.0);
    vec3 colEdge = 1.5*vec3(0.48,0.53,0.5);
    result *= mix( colCenter, colEdge, min( (radius+.05)/.9, 1.15 ) );

    return result;
}

bool RaySphereIntersect(vec3 org, vec3 dir, out float near, out float far)
{
    float b = dot(dir, org);
    float c = dot(org, org) - 8.;
    float delta = b*b - c;
    if( delta < 0.0)
        return false;
    float deltasqrt = sqrt(delta);
    near = -b - deltasqrt;
    far = -b + deltasqrt;
    return far > 0.0;
}

vec3 volumetricSupernova(vec2 fragCoord)
{
    // ro: ray origin, rd: ray direction
    vec3 rd = normalize(vec3((fragCoord - 0.5*windowSize)/windowSize.y, 1.));
    // After the blast forms, dolly the camera forward so the explosion engulfs
    // the frame and we fly out the other side (it exits the frame, no implosion).
    float localT = max(uTime - uClickTime, 0.0);
    float dolly = smoothstep(tExpand * 0.4, tExpand + tFly, localT) * flyDist;
    vec3 ro = vec3(0., 0., -6. + dolly);

    // ld, td: local/total density ; w: weighting factor
    float ld=0., td=0., w=0.;
    // t: ray length ; d: distance function
    float d=1., t=0.;
    const float h = 0.1;

    vec4 sum = vec4(0.0);
    float min_dist=0.0, max_dist=0.0;

    if(RaySphereIntersect(ro, rd, min_dist, max_dist))
    {
        t = min_dist*step(t,min_dist);

        for (int i=0; i<86; i++)
        {
            vec3 pos = ro + t*rd;

            if(td>0.9 || d<0.11*t || t>10. || sum.a > 0.99 || t>max_dist) break;

            float d = map(pos);

            vec3 ldst = vec3(0.0)-pos;
            float lDist = max(length(ldst), 0.001);

            vec3 lightColor=vec3(1.0,0.5,0.25);
            sum.rgb+=(vec3(0.67,0.75,1.00)/(lDist*lDist*15.)/100.); // star itself
            sum.rgb+=(lightColor/exp(lDist*lDist*lDist*.08)/30.);   // bloom

            if (d<h)
            {
                ld = h - d;
                w = (1. - td) * ld;
                td += w + 1./200.;

                vec4 col = vec4( computeColor(td,lDist), td );
                sum += sum.a * vec4(sum.rgb, 0.0) * 0.2 / lDist; // emission
                col.a *= 0.2;
                col.rgb *= col.a;
                sum = sum + col*(1.0 - sum.a); // alpha blend
            }

            td += 1./70.;

            // adaptive step size
            t += max(d * 0.1 * max(min(length(ldst),length(ro)),0.1), 0.01);
        }

        sum *= 1. / exp( ld * 0.2 ) * 0.8; // simple scattering
        sum = clamp( sum, 0.0, 1.0 );
        sum.xyz = sum.xyz*sum.xyz*(3.0-2.0*sum.xyz);
    }

    return sum.xyz;
}

//=====================================================================
// Planetary nebula, ported from nimitz 2023 (https://www.shadertoy.com/view/fl2Bzd)
// CC BY-NC-SA 3.0. Self-contained (procedural). Functions prefixed "neb"
// to avoid clashing with this shader's own map()/stars().
//=====================================================================

mat3 rot_x(float a){float sa = sin(a); float ca = cos(a); return mat3(1.,.0,.0,    .0,ca,sa,   .0,-sa,ca);}
mat3 rot_y(float a){float sa = sin(a); float ca = cos(a); return mat3(ca,.0,sa,    .0,1.,.0,   -sa,.0,ca);}
const mat3 m3 = mat3(0.33338, 0.56034, -0.71817, -0.87887, 0.32651, -0.15323, 0.15162, 0.69596, 0.61339)*2.1;
mat2 mm2(in float a){float c = cos(a), s = sin(a);return mat2(c,s,-s,c);}

float linstep(in float mn, in float mx, in float x){return clamp((x - mn)/(mx - mn), 0., 1.);}

float nebMap(vec3 p)
{
    p.yz *= mm2(-0.37);
    vec3 dz = vec3(p.z*.0,p.z*.0,p.z*.75);
    float cl = -abs(dot(p ,p-dz*1. )-10.0) + 2.0;
    float cl2 = -dot(p.xy,p.xy) + 7.0;
    cl = mix(cl,cl2,.35);

    float d = 0.;
    p *= 0.54;
    float z = 3.5;
    float trk = 1.;
    for(int i = 0; i < 5; i++)
    {
        p += sin(p.zxy*trk - 0.5)*0.25;
        d -= abs(dot(cos(p), sin(p.zxy + 0.6)) - .3)*z - 1.8;
        z *= 0.7;
        p = p*m3;
        trk *= 1.45;
    }

    return clamp(d*.9 + cl*.9,-20.,1000.);
}

float nebCurv(in vec3 p, in float p0, in float w)
{
    vec2 e = vec2(-1., 1.)*w;
    float t1 = nebMap(p + e.yxx), t2 = nebMap(p + e.xxy);
    float t3 = nebMap(p + e.xyx), t4 = nebMap(p + e.yyy);
    return .25/e.y*(t1 + t2 + t3 + t4 - 4.0*p0);
}

vec4 nebRender( in vec3 ro, in vec3 rd )
{
    vec4 rez = vec4(0);
    float t = 9.;
    for(int i=0; i<95; i++)
    {
        if(rez.a > 0.95 || t > 17.)break;

        vec3 pos = ro + t*rd;
        float dtp = dot(pos,pos);
        float dn = nebMap(pos);
        float den = clamp(dn, 0.0, 1.3);

        float ext = linstep(60.,15.,dtp);
        float dt2 = linstep(0.,30.,dtp)+0.35;
        float crv = linstep(-3.5,-15., nebCurv(pos*.75, dn, .65*dt2))*0.5+0.035;

        vec4 col = vec4((sin(vec3(3.7,1.7,.9) + dtp*0.03+4.9)*vec3(0.4,0.17,0.25)+vec3(0.2,0.01,0.1)) ,0.05)*den;
        col.xyzw *= vec4(0.25,0.37,.3,1.)*crv*ext;

        float dif =  clamp((nebMap(pos * 1.09)- dn)*1.2, -.8, 6. );
        col.xyz *= vec3(1.) + vec3(.9,.8,.7)*dif;

        col.rgba += vec4(.75,.6,.5, 0.01)*clamp(0.07/dtp, 0., 5.)*(crv*0. + .2)*smoothstep(7.,-5.,dtp);
        rez = rez + col*(1. - rez.a);

        t += clamp(0.06 - den*.1, 0.065, 0.15);
    }
    return clamp(rez, 0.0, 1.0);
}

vec4 nebHash43x(vec3 p)
{
    uvec3 x = uvec3(ivec3(p));
    x = 1103515245U*((x.xyz >> 1U)^(x.yzx));
    uint h = 1103515245U*((x.x^x.z)^(x.y>>3U));
    uvec4 rz = uvec4(h, h*16807U, h*48271U, h*69621U);
    return vec4((rz >> 1) & uvec4(0x7fffffffU))/float(0x7fffffff);
}

vec3 nebStars(vec3 p)
{
    vec3 col = vec3(0);
    float rad = .087*windowSize.y;
    float dens = 0.15;
    float id = 0.;
    float z = 1.;

    for (float i = 0.; i < 5.; i++)
    {
        p *= mat3(0.86564, -0.28535, 0.41140, 0.50033, 0.46255, -0.73193, 0.01856, 0.83942, 0.54317);
        vec3 q = abs(p);
        vec3 p2 = p/max(q.x, max(q.y,q.z));
        p2 *= rad;
        vec3 ip = floor(p2 + 1e-5);
        vec3 fp = fract(p2 + 1e-5);
        vec4 rand = nebHash43x(ip*283.1);
        vec3 q2 = abs(p2);
        vec3 pl = 1.0- step(max(q2.x, max(q2.y, q2.z)), q2);
        vec3 pp = fp - ((rand.xyz-0.5)*.6 + 0.5)*pl;
        float pr = length(ip) - rad;
        if (rand.w > (dens - dens*pr*0.035)) pp += 1e6;

        float d = dot(pp, pp);
        d /= pow(fract(rand.w*172.1), 32.) + .25;
        float bri = dot(rand.xyz*(1.-pl),vec3(1));
        id = fract(rand.w*101.);
        col += bri*z*.00009/pow(d + 0.025, 3.0)*(mix(vec3(1.0,0.45,0.1),vec3(0.75,0.85,1.), id)*0.6+0.4);

        rad = floor(rad*1.08);
        dens *= 1.45;
        z *= 0.6;
        p = p.yxz;
    }

    return col;
}

vec3 nebula(vec2 fragCoord)
{
    vec2 q = fragCoord / windowSize;
    vec2 p = q - 0.5;
    p.x *= aspect;

    // iMouse replaced by the shader's default view + a slow auto-rotation
    vec2 mo = vec2(-0.25, 0.15);
    mo.x *= aspect;
    mo *= 3.14;
    mo.y = clamp(mo.y*0.6 - 0.5, -4., 0.15);

    vec3 ro = vec3(0., 0., 12.);
    vec3 rd = normalize(vec3(p, -1.4));

    mat3 cam = rot_x(-mo.y)*rot_y(-mo.x + sin(uTime*0.2)*0.15);
    rd *= cam;
    ro *= cam;

    vec4 scn = nebRender(ro, rd);
    // Return only the emissive gas (no nebStars, no vignette, no full-frame
    // background) so the nebula layers over the existing scene instead of
    // replacing it. Transparent (black) where there is no gas.
    return pow(scn.xyz, vec3(0.5));
}

void main() {
    vec2 uv = gl_FragCoord.xy / windowSize;
    vec2 dir = uv - vec2(0.5,0.5);

    float tOffset = 0.05 * sin(uTime - uClickTime * 3.14);
    float rD = getOffsetStrength(uTime - uClickTime + tOffset, dir);
    float gD = getOffsetStrength(uTime - uClickTime, dir);
    float bD = getOffsetStrength(uTime - uClickTime - tOffset, dir);

    dir = normalize(dir);

    vec4 texel;
    texel.r = texture(texture_sampler, uv + dir * rD * uClicked).r;
    texel.g = texture(texture_sampler, uv + dir * gD * uClicked).g;
    texel.b = texture(texture_sampler, uv + dir * bD * uClicked).b;

    vec3 starGlow = vec3(0.0);
    starGlow += stars(uv, 0.08, uTime);
    starGlow += stars(uv, 0.12, uTime);
    starGlow += stars(uv, 0.25, uTime);

    vec3 novaGlow = vec3(0.0);
    novaGlow += nova(uv, uTime);

    vec3 base = texel.rgb + starGlow + novaGlow;

    float boomT = uTime - uClickTime;

    // Volumetric supernova, triggered by the click. Only raymarched while it is
    // actually on screen (before it has flown out of frame) -- the rest is wasted work.
    vec3 sn = vec3(0.0);
    if (uClicked != 0 && boomT < tExpand + tFly) {
        sn = volumetricSupernova(gl_FragCoord.xy);
    }
    float boom = float(uClicked) * smoothstep(0.0, 0.4, boomT) * (1.0 - smoothstep(tExpand + tFly - 0.8, tExpand + tFly, boomT));

    vec3 scene = base + sn * boom;

    // Nebula remnant: fades in after the blast. Tune nebulaStart / nebulaFade above.
    // Only raymarched once it has begun to appear.
    vec3 neb = vec3(0.0);
    float nebAppear = 0.0;
    if (uClicked != 0 && boomT > nebulaStart) {
        neb = nebula(gl_FragCoord.xy);
        nebAppear = smoothstep(nebulaStart, nebulaStart + nebulaFade, boomT);
    }

    // Additive: the nebula gas glows over the existing background (stars stay).
    output_color = vec4(scene + neb * nebAppear, 1.0);
}
